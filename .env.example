# Add the assigned hostname for hosted development environments.
# ALLOWED_HOSTS=<your-hostname>
# CSRF_TRUSTED_ORIGINS=https://<your-hostname>

# Set only when the host mounts this app below a path prefix.
# FORCE_SCRIPT_NAME=/proxy/8000
# Enable only if the host also adds the script prefix to redirect Location headers.
# STRIP_PREFIX_FROM_REDIRECTS=true
